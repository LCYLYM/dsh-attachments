{
  "name": "dsh-multimedia-webui-input",
  "version": "0.2.0-rc.1",
  "description": "Better Attach: intentional folder drops, previews and copy-on-send attachments for DeepSeek Harness.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LCYLYM/dsh-attachments.git"
  },
  "bugs": {
    "url": "https://github.com/LCYLYM/dsh-attachments/issues"
  },
  "homepage": "https://github.com/LCYLYM/dsh-attachments#readme",
  "engines": {
    "node": ">=22.16.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "dshClient": {
    "inject": [
      "@deepseek-ai/dsh-client-runtime",
      "@deepseek-ai/dsh-client-ui-input-trigger",
      "@deepseek-ai/dsh-client-ui-conversation",
      "@deepseek-ai/dsh-client-ui-settings"
    ],
    "platform": "web"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "attachments",
    "drag-and-drop",
    "workspace"
  ],
  "files": [
    "lib",
    "src",
    "scripts",
    "demo",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "CHANGELOG.md",
    "tests",
    "install.sh",
    "install.ps1",
    "START-DEMO.sh",
    "START-DEMO.cmd",
    "SECURITY.md",
    "artifacts/node-tests.tap",
    "artifacts/browser-tests.json",
    "artifacts/browser-tests.log",
    "artifacts/acceptance.json",
    "artifacts/doctor.json",
    "artifacts/release-gate.json",
    "artifacts/live-dsh.template.json",
    "DELIVERY.html"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "demo": "node demo/server.mjs",
    "doctor": "node scripts/doctor.mjs",
    "check": "npm run build && npm test && npm run doctor",
    "prepack": "npm run build",
    "release:check": "node scripts/release-check.mjs",
    "prepublishOnly": "npm run check && npm run release:check"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  }
}
